  subgraph FE_Store["Client Storage"]
    direction TB
    FE_LSView["localStorage: cadie-view-mode"]
    FE_LSBill["localStorage: billing celebration dedupe key"]
    FE_LSTheme["localStorage: theme persistence"]
  end

  subgraph FE_Auth["Client Auth"]
    direction TB
    FE_UseAuth["src/hooks/use-auth.ts: supabase.auth.getUser() + onAuthStateChange()"]
    FE_Cookies["Supabase session cookies"]
    FE_ClientEnv["Client env: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY, NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST, NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_BASE_URL, NODE_ENV"]
