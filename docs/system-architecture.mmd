  end

  subgraph BE_Async["Async Jobs"]
    direction TB
    BE_LinkRead["GetLinksHandler and read-only link queries"]
    BE_LinkWrite["CreateLinkHandler, LinkService, batch update or delete flows"]
    BE_LinkCreateFlow["POST /api/links pipeline: validate -> auth -> rate limit -> idempotency -> billing -> create"]
    BE_LinkDup["Duplicate detection or restore-from-trash"]
    BE_After["after(): non-blocking post-create branch"]
    BE_AutoForward["AutoSpaceForwardingService: rules, heuristics, optional AI"]
    BE_JobQueue["src/lib/job-queue.ts: publishJSON() to QStash"]
    BE_QVerify["Receiver.verify(): upstash-signature"]
    BE_MetadataSvc["MetadataService: enrich link metadata"]
    BE_AITagSvc["AITaggingService: URL and document tags"]
    BE_AIVisionSvc["AI vision tagging for image items"]
    BE_ImportSvc["BookmarkImportService: preview, start, process job"]
    BE_ExtRecovery["Extension-only recovery path after save"]
  end

  subgraph BE_Cron["Cron & Maintenance"]
    direction TB
    BE_CronGuard["CRON_SECRET Bearer auth guard"]
    BE_CleanupTrash["Cleanup trash: hard-delete old trashed links"]
    BE_CleanupImports["Cleanup imports: expire old bookmark import jobs"]
    BE_BillReconcile["Billing reconcile: scan rows then syncSubscription()"]
  end

  subgraph BE_Cross["Cross-Cutting"]
    direction TB
    BE_RateLimit["src/lib/rate-limit.ts: Upstash sliding-window limiters"]
    BE_Idem["src/lib/idempotency.ts: Upstash Redis or memory idempotency cache"]
    BE_Logger["src/lib/logger.ts"]
    BE_SentrySrv["src/instrumentation.ts: Sentry server and edge init"]
    BE_PostHogSrv["src/lib/posthog-server.ts"]
    BE_ServerEnv["Server env: SUPABASE_SERVICE_ROLE_KEY, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN, QSTASH_TOKEN, QSTASH_CURRENT_SIGNING_KEY, QSTASH_NEXT_SIGNING_KEY, CRON_SECRET, INTERNAL_API_SECRET, LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_STORE_ID, LEMONSQUEEZY_WEBHOOK_SECRET, LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID, LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID, LEMONSQUEEZY_BELIEVER_YEARLY_VARIANT_ID, LEMONSQUEEZY_TEST_MODE, OPENAI_API_KEY, GOOGLE_AI_API_KEY, NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_BASE_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, NODE_ENV, NEXT_RUNTIME"]
    ERR_401["401 Unauthorized"]
    ERR_429["429 Rate Limited"]
    ERR_Plan["PLAN_LIMIT_REACHED"]
    ERR_Webhook["Invalid webhook signature"]
    ERR_QSig["QStash signature missing or invalid"]
    ERR_NoSub["No matching Lemon subscription"]
    ERR_Idem["Idempotent replay"]
  end
end

