  subgraph BE_Billing["Billing"]
    direction TB
    BE_BillCtx["src/lib/billing/context.ts: getBillingContext()"]
    BE_PlanResolver["src/lib/billing/plan-resolver.ts: resolvePlanForUser() fail-closed"]
    BE_LemonClient["src/lib/billing/lemon-client.ts: checkout, portal, variant prices"]
    BE_BillSync["src/lib/billing/sync.ts: syncSubscription()"]
    BE_WebhookSig["verifyLemonWebhookSignature(): x-signature HMAC SHA-256"]
    BE_WebhookProc["src/lib/billing/webhook-handler.ts: processLemonWebhook()"]
